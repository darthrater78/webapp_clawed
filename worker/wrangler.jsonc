{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "clawdmeter-usage",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "kv_namespaces": [{ "binding": "USAGE_KV", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }],
  "vars": {
    "ALLOWED_ORIGIN": "https://REPLACE_WITH_STATIC_APP_ORIGIN",
    "CLAUDE_TOKEN_URL": "https://platform.claude.com/v1/oauth/token"
  }
}