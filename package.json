    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.8",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.70.1",
    "vite": "8.3.0"
  },
  "engines": {
    "node": ">=22.12"
